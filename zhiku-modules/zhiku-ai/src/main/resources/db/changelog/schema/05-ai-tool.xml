<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                                       http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20261006-68-ai-tool" author="zhiku">
        <createTable tableName="ai_tool" remarks="AI 工具表（HTTP 模板工具，供模型 Function Calling 调用）">
            <column name="tool_id" type="bigint" remarks="工具ID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tool_name" type="varchar(64)" remarks="工具名（唯一，function calling 名称，字母开头字母数字下划线连字符）">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="varchar(500)" remarks="给模型看的语义说明">
                <constraints nullable="false"/>
            </column>
            <column name="icon" type="varchar(32)" remarks="图标（emoji）"/>
            <column name="method" type="varchar(10)" remarks="请求方式（GET/POST/PUT/DELETE）">
                <constraints nullable="false"/>
            </column>
            <column name="url_template" type="varchar(1000)" remarks="URL 模板（scheme+host 禁止参数占位）">
                <constraints nullable="false"/>
            </column>
            <column name="headers" type="varchar(2000)" remarks="请求头 JSON 数组 [{key,value}]，value 支持 {{参数}}"/>
            <column name="query_params" type="varchar(2000)" remarks="查询参数 JSON 数组 [{key,value}]，value 支持 {{参数}}"/>
            <column name="body_template" type="clob" remarks="请求体模板，支持 {{参数}}"/>
            <column name="param_schema" type="clob" remarks="入参 JSON Schema（根必须 object，即 Function Calling parameters）"/>
            <column name="auth_type" type="char(1)" defaultValue="0" remarks="鉴权类型（0无 1Bearer 2自定义头）"/>
            <column name="auth_key" type="varchar(64)" remarks="自定义鉴权头名（auth_type=2 必填）"/>
            <column name="auth_value" type="varchar(512)" remarks="鉴权凭据（加密存储，出口掩码）"/>
            <column name="allow_intranet" type="char(1)" defaultValue="0" remarks="允许内网目标（0否 1是，SSRF 白名单）"/>
            <column name="timeout_seconds" type="int" defaultValueNumeric="10" remarks="超时秒数（connect/read 共用，上限60）"/>
            <column name="status" type="char(1)" defaultValue="0" remarks="状态（0启用 1停用）"/>
            <column name="del_flag" type="char(1)" defaultValue="0" remarks="删除标志（0存在 2删除）"/>
            <column name="create_dept" type="bigint" remarks="创建部门"/>
            <column name="create_by" type="bigint" remarks="创建者"/>
            <column name="create_time" type="datetime" remarks="创建时间"/>
            <column name="update_by" type="bigint" remarks="更新者"/>
            <column name="update_time" type="datetime" remarks="更新时间"/>
        </createTable>
        <createIndex indexName="idx_tool_name" tableName="ai_tool">
            <column name="tool_name"/>
        </createIndex>
    </changeSet>

    <changeSet id="20261006-69-ai-app-tool-rel" author="zhiku">
        <createTable tableName="ai_app_tool_rel" remarks="应用-工具挂载表（多对多，M4 应用配置页消费）">
            <column name="rel_id" type="bigint" remarks="关联ID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="app_id" type="bigint" remarks="应用ID">
                <constraints nullable="false"/>
            </column>
            <column name="tool_id" type="bigint" remarks="工具ID">
                <constraints nullable="false"/>
            </column>
            <column name="create_by" type="bigint" remarks="创建者"/>
            <column name="create_time" type="datetime" remarks="创建时间"/>
        </createTable>
        <addUniqueConstraint tableName="ai_app_tool_rel" columnNames="app_id,tool_id" constraintName="uk_app_tool"/>
        <createIndex indexName="idx_rel_app" tableName="ai_app_tool_rel">
            <column name="app_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="20261006-70-ai-tool-call-log" author="zhiku">
        <createTable tableName="ai_tool_call_log" remarks="工具调用审计表（试运行与对话调用均记录）">
            <column name="log_id" type="bigint" remarks="日志ID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tool_id" type="bigint" remarks="工具ID"/>
            <column name="tool_name" type="varchar(64)" remarks="工具名（冗余，防工具删除后不可读）"/>
            <column name="app_id" type="bigint" remarks="应用ID（试运行为空）"/>
            <column name="message_id" type="bigint" remarks="消息ID（M4 对话时经 ToolContext 传入）"/>
            <column name="scene" type="char(1)" remarks="场景（0试运行 1对话调用）"/>
            <column name="request_snapshot" type="clob" remarks="渲染后请求快照（鉴权头脱敏）"/>
            <column name="response_snapshot" type="clob" remarks="响应快照（截断后）"/>
            <column name="http_status" type="int" remarks="HTTP 状态码（异常为空）"/>
            <column name="success" type="char(1)" remarks="是否成功（0否 1是）"/>
            <column name="error_msg" type="varchar(1000)" remarks="错误信息"/>
            <column name="duration_ms" type="int" remarks="耗时毫秒"/>
            <column name="create_by" type="bigint" remarks="创建者"/>
            <column name="create_time" type="datetime" remarks="创建时间"/>
        </createTable>
        <createIndex indexName="idx_tool_log_tool" tableName="ai_tool_call_log">
            <column name="tool_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
